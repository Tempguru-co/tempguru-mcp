{
  "name": "tempguru-mcp",
  "version": "1.6.0",
  "private": true,
  "description": "TempGuru MCP server across 345 US/CA markets: nine read-only lookups, a compatibility planner, an explicit non-contact saved-plan write, and one opt-in request_quote contact submission.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:okf && next build",
    "build:stdio": "node scripts/sync-rates.mjs --check && esbuild src/mcp-stdio.ts --bundle --platform=node --format=esm --outfile=dist/mcp-stdio.mjs --packages=external",
    "build:cli": "node scripts/gen-skill-digests.mjs && rm -rf cli/skills cli/index.mjs cli/LICENSE && esbuild src/mcp-stdio.ts --bundle --platform=node --format=esm --outfile=cli/index.mjs --banner:js='#!/usr/bin/env node' && cp -R skills cli/skills && cp LICENSE cli/LICENSE",
    "check:cli-package": "node scripts/check-cli-package.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "evals": "node evals/run-evals.mjs",
    "test:protocol": "node evals/protocol-eras.test.mjs",
    "test:unit": "node evals/unit.test.mjs",
    "build:okf": "node scripts/gen-skill-digests.mjs && node scripts/dump-openapi.mjs && node scripts/dump-request-schema.mjs && node scripts/build-okf.mjs",
    "build:worker": "node scripts/build-edge-worker.mjs",
    "build:llms-worker": "node scripts/build-llms-worker.mjs",
    "build:url-map": "node scripts/build-url-map.mjs",
    "sync-rates": "node scripts/sync-rates.mjs",
    "sync:postman": "node scripts/sync-postman-examples.mjs",
    "check-rates": "node scripts/sync-rates.mjs --check",
    "check:live-discovery": "node scripts/check-live-discovery.mjs",
    "check:submissions": "node scripts/sync-postman-examples.mjs --check && node scripts/check-submissions.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@upstash/redis": "^1.38.0",
    "next": "16.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
