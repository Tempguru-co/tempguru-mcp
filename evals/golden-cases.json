[
  {
    "name": "plan_staffing builds a full plan (Chicago trade show)",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Chicago",
      "event_date": "2027-03-10",
      "event_type": "trade-show",
      "roles": [
        {
          "role": "registration-staff",
          "headcount": 6,
          "hours_per_shift": 8,
          "days": 2
        },
        {
          "role": "team-leads",
          "headcount": 1
        }
      ]
    },
    "expect": [
      "\\\"status\\\": \\\"plan\\\"",
      "estimated_total_range",
      "lead_time",
      "compliance",
      "request_quote"
    ]
  },
  {
    "name": "plan_staffing flags the team-lead rule at 20+ staff",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Austin",
      "roles": [
        {
          "role": "brand-ambassadors",
          "headcount": 22
        }
      ]
    },
    "expect": [
      "team lead",
      "20 or more"
    ]
  },
  {
    "name": "plan_staffing without roles returns the catalog",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Boston",
      "attendees": 300
    },
    "expect": [
      "needs_roles",
      "available_roles"
    ]
  },
  {
    "name": "plan_staffing warns on daily overtime in California",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Los Angeles",
      "roles": [
        {
          "role": "brand-ambassadors",
          "headcount": 4,
          "hours_per_shift": 10
        }
      ]
    },
    "expect": [
      "daily overtime",
      "OT",
      "overtime_adjusted_total_range"
    ]
  },
  {
    "name": "get_role_pricing returns Boston brand-ambassador range",
    "tool": "get_role_pricing",
    "arguments": {
      "role": "Brand Ambassadors",
      "city": "Boston"
    },
    "expect": [
      "hourly_range_low",
      "Boston",
      "all_inclusive"
    ]
  },
  {
    "name": "get_role_pricing prices the new Assistant Leads role (Boston hub)",
    "tool": "get_role_pricing",
    "arguments": {
      "role": "Assistant Leads",
      "city": "Boston"
    },
    "expect": [
      "Assistant Leads",
      "hourly_range_low",
      "56",
      "67"
    ]
  },
  {
    "name": "get_roles includes the Assistant Leads role in the catalog",
    "tool": "get_roles",
    "arguments": {},
    "expect": [
      "assistant-leads",
      "Assistant Leads"
    ]
  },
  {
    "name": "get_role_pricing handles an unknown role gracefully",
    "tool": "get_role_pricing",
    "arguments": {
      "role": "unicorn wranglers",
      "city": "Boston"
    },
    "expect": [
      "role_found",
      "available_roles"
    ]
  },
  {
    "name": "check_availability returns a lead-time read",
    "tool": "check_availability",
    "arguments": {
      "date": "2027-03-10",
      "city": "Dallas"
    },
    "expect": [
      "days_until_event",
      "recommendation",
      "lead time"
    ]
  },
  {
    "name": "get_compliance_by_state knows California daily OT + 2026 min wage + sourcing",
    "tool": "get_compliance_by_state",
    "arguments": {
      "state": "CA"
    },
    "expect": [
      "overtime_threshold_daily_hours",
      "unique_rules",
      "W-2",
      "16.9",
      "min_wage_source",
      "data_current_as_of"
    ]
  },
  {
    "name": "get_cities filters by state",
    "tool": "get_cities",
    "arguments": {
      "state": "TX"
    },
    "expect": [
      "tier_breakdown",
      "\\\"state_abbr\\\": \\\"TX\\\""
    ]
  },
  {
    "name": "get_cities single-city catalog check (borough resolves to parent metro)",
    "tool": "get_cities",
    "arguments": {
      "city": "Brooklyn"
    },
    "expect": [
      "catalog_check",
      "catalog_match",
      "coverage_confirmation_required",
      "New York City"
    ]
  },
  {
    "name": "get_cities caps an unfiltered list with limit + note",
    "tool": "get_cities",
    "arguments": {
      "limit": 5
    },
    "expect": [
      "returned",
      "note",
      "tier_breakdown"
    ]
  },
  {
    "name": "get_rate_benchmark returns the citable Rate Index",
    "tool": "get_rate_benchmark",
    "arguments": {
      "role": "brand-ambassadors"
    },
    "expect": [
      "Rate Index",
      "citation",
      "by_tier_usd",
      "55-65"
    ]
  },
  {
    "name": "plan_staffing: valid city + unmatched role returns roles_not_found (not city_not_found)",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Chicago",
      "roles": [
        {
          "role": "sword swallowers",
          "headcount": 3
        }
      ]
    },
    "expect": [
      "roles_not_found",
      "Chicago",
      "available_roles"
    ]
  },
  {
    "name": "plan_staffing: alias city (NYC) + role synonym (security) resolve, structured output emitted",
    "tool": "plan_staffing",
    "arguments": {
      "city": "NYC",
      "roles": [
        {
          "role": "security",
          "headcount": 5
        }
      ]
    },
    "expect": [
      "New York City",
      "Crowd Control",
      "plan_lines",
      "structuredContent"
    ]
  },
  {
    "name": "plan_staffing: misspelled city is NOT auto-resolved; returns city_not_found + did-you-mean",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Chicagoo",
      "roles": [
        {
          "role": "brand-ambassadors",
          "headcount": 2
        }
      ]
    },
    "expect": [
      "city_not_found",
      "suggestion",
      "Chicago"
    ]
  },
  {
    "name": "get_rate_benchmark: unknown role returns role_found:false, not Event Staff rates",
    "tool": "get_rate_benchmark",
    "arguments": {
      "role": "wizard"
    },
    "expect": [
      "role_found",
      "available_roles"
    ]
  },
  {
    "name": "get_rate_benchmark tier filter adds the measured tier span (tier_usd)",
    "tool": "get_rate_benchmark",
    "arguments": {
      "tier": "hub"
    },
    "expect": [
      "requested_tier",
      "tier_usd",
      "Rate Index"
    ]
  },
  {
    "name": "plan_staffing: 'London, UK' is rejected, never resolved to London, Ontario",
    "tool": "plan_staffing",
    "arguments": {
      "city": "London, UK",
      "roles": [
        {
          "role": "brand-ambassadors",
          "headcount": 2
        }
      ]
    },
    "expect": [
      "city_not_found"
    ]
  },
  {
    "name": "plan_staffing: Toronto prices Ontario weekly OT with provincial compliance",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Toronto",
      "roles": [
        {
          "role": "brand-ambassadors",
          "headcount": 1,
          "hours_per_shift": 10,
          "days": 5
        }
      ]
    },
    "expect": [
      "Ontario",
      "CAD",
      "overtime_adjusted_total_range",
      "coordinator"
    ]
  },
  {
    "name": "plan_staffing: partial plan is labeled incomplete and blocks quoting",
    "tool": "plan_staffing",
    "arguments": {
      "city": "Chicago",
      "roles": [
        {
          "role": "registration-staff",
          "headcount": 2
        },
        {
          "role": "sword swallowers",
          "headcount": 3
        }
      ]
    },
    "expect": [
      "plan_complete",
      "unpriced_roles",
      "Do NOT prepare"
    ]
  },
  {
    "name": "get_role_pricing: 'security' resolves to Crowd Control WITH the unarmed warning",
    "tool": "get_role_pricing",
    "arguments": {
      "role": "security",
      "city": "Boston"
    },
    "expect": [
      "Crowd Control",
      "NOT licensed"
    ]
  },
  {
    "name": "get_cities: unknown country is an explicit error, not a US dump",
    "tool": "get_cities",
    "arguments": {
      "country": "USSR"
    },
    "expect": [
      "must be US or CA"
    ]
  },
  {
    "name": "check_availability: impossible calendar date is rejected, not rolled over",
    "tool": "check_availability",
    "arguments": {
      "city": "Dallas",
      "date": "2027-02-30"
    },
    "expect": [
      "Impossible"
    ]
  },
  {
    "name": "get_plan: unknown or expired plan returns a clean miss",
    "tool": "get_plan",
    "arguments": {
      "plan_id": "ABCDEFGH2345"
    },
    "expect": [
      "plan_found",
      "not found or has expired",
      "plan_staffing"
    ]
  },
  {
    "name": "get_policies: returns sourced payment policy plus explicit TODOs",
    "tool": "get_policies",
    "arguments": {
      "topic": "payment-terms"
    },
    "expect": [
      "policy_found",
      "No payment is required",
      "TODO-for-Megan"
    ]
  },
  {
    "name": "get_policies: unknown topic returns available topics",
    "tool": "get_policies",
    "arguments": {
      "topic": "free-unicorn-delivery"
    },
    "expect": [
      "policy_not_found",
      "available_topics",
      "payment-terms"
    ]
  },
  {
    "name": "get_quote_status: unknown reference returns a clean miss",
    "tool": "get_quote_status",
    "arguments": {
      "reference": "TG-ABC234"
    },
    "expect": [
      "quote_found",
      "not found",
      "one business day"
    ]
  },
  {
    "name": "save_staffing_plan explicitly persists a server-recomputed non-PII artifact",
    "tool": "save_staffing_plan",
    "arguments": {
      "city": "Boston",
      "event_date": "2027-04-18",
      "event_type": "conference",
      "attendees": 400,
      "roles": [
        {
          "role": "registration-staff",
          "headcount": 6,
          "hours_per_shift": 8,
          "days": 2
        }
      ]
    },
    "expect": [
      "\"status\":\"saved\"",
      "\"schema_version\":\"1.0\"",
      "\"plan_id\"",
      "\"resource_uri\"",
      "\"quote_readiness\":\"buyer_submission_required\""
    ]
  },
  {
    "name": "plan_id round-trip restores the plan and creates a buyer-operated quote handoff",
    "workflow": "plan_quote_roundtrip",
    "arguments": {
      "plan": {
        "city": "Chicago",
        "event_date": "2027-03-10",
        "event_type": "trade-show",
        "roles": [
          {
            "role": "registration-staff",
            "headcount": 6,
            "hours_per_shift": 8,
            "days": 2
          }
        ]
      }
    },
    "expect": [
      "plan_id",
      "plan_found",
      "handoff_ready",
      "buyer_submission_required",
      "form_url",
      "request-quote",
      "source_platform"
    ]
  }
]
