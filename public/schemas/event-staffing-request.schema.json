{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contact_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Full name of the contact person"
    },
    "contact_email": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "description": "Contact email address for the quote response"
    },
    "contact_phone": {
      "description": "Optional phone number for the coordinator to reach the buyer (event ops is phone-first; include when known)",
      "type": "string",
      "maxLength": 40
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Company or organization name"
    },
    "event_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Name of the event (e.g. 'HIMSS 2026', 'Brand Fest Austin')"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Event type: trade-show, conference, festival, concert, sporting-event, corporate, brand-activation, or other"
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "City where the event is held"
    },
    "event_dates": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Event dates as a human-readable string, e.g. 'June 15–17, 2026'"
    },
    "venue": {
      "description": "Primary venue name and/or address, when known",
      "type": "string",
      "maxLength": 200
    },
    "attendees": {
      "description": "Expected event attendance, if known (informs coverage ratios)",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 5000000
    },
    "roles": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Staffing role name, e.g. brand-ambassadors, registration-staff"
          },
          "headcount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Number of staff needed"
          },
          "shifts": {
            "description": "Shift description, e.g. '2 days × 8h'",
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "role",
          "headcount"
        ],
        "additionalProperties": false
      },
      "description": "Roles and headcount needed for the event"
    },
    "locations": {
      "description": "Additional cities for a multi-city / tour program. The top-level city, dates, and roles describe the primary or first location; each entry here adds another.",
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "City for this leg of a multi-city program"
          },
          "venue": {
            "description": "Venue for this location, if known",
            "type": "string",
            "maxLength": 200
          },
          "event_dates": {
            "description": "Dates for this location, if they differ from the top-level dates",
            "type": "string",
            "maxLength": 160
          },
          "roles": {
            "description": "Roles for this location if they differ from the top-level roles",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Staffing role name"
                },
                "headcount": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 10000,
                  "description": "Number of staff needed at this location"
                },
                "shifts": {
                  "description": "Shift description for this location",
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": [
                "role",
                "headcount"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "city"
        ],
        "additionalProperties": false
      }
    },
    "budget_range": {
      "description": "Estimated total budget range if calculated, e.g. '$8,400–$12,600'",
      "type": "string",
      "maxLength": 120
    },
    "attire": {
      "description": "Staff attire requirements",
      "type": "string",
      "maxLength": 500
    },
    "special_requirements": {
      "description": "Any special requirements: language skills, certifications, overnight shifts, etc.",
      "type": "string",
      "maxLength": 2000
    },
    "compliance_notes": {
      "description": "Any compliance flags surfaced by get_compliance_by_state",
      "type": "string",
      "maxLength": 2000
    },
    "source_platform": {
      "description": "Optional agent/platform attribution, e.g. chatgpt-gpt, claude-desktop, coze",
      "type": "string",
      "enum": [
        "ai-agent",
        "ai-page",
        "ai-page-zh",
        "baidu-agent",
        "chatgpt-app",
        "chatgpt-gpt",
        "claude-ai",
        "claude-code",
        "claude-desktop",
        "cn-agent",
        "copilot-agent",
        "coze",
        "coze-bot",
        "custom-gpt",
        "gemini",
        "gemini-cli",
        "gemini-gem",
        "hermes",
        "kimi",
        "langchain",
        "lechat-agent",
        "llamaindex",
        "manual-test",
        "meta-ai",
        "mcp-handoff",
        "open-webui",
        "openai-codex",
        "openclaw",
        "perplexity-space",
        "pi",
        "poe-bot",
        "postman",
        "prime-agent",
        "python-client",
        "skill",
        "team-demo",
        "website",
        "website-widget",
        "zhipu-agent",
        "openai-chatgpt",
        "openai-agents-sdk",
        "openai-mcp",
        "cursor",
        "cline",
        "windsurf",
        "perplexity",
        "qwen-ecosystem",
        "deepseek",
        "doubao",
        "mcp-client"
      ]
    },
    "utm_source": {
      "description": "Canonical acquisition source carried by a TempGuru-generated buyer handoff URL",
      "type": "string",
      "enum": [
        "ai-agent"
      ]
    },
    "utm_medium": {
      "description": "Canonical agent runtime or MCP/REST medium carried by the buyer handoff URL",
      "type": "string",
      "enum": [
        "mcp",
        "rest",
        "ai-agent",
        "ai-page",
        "ai-page-zh",
        "baidu-agent",
        "chatgpt-app",
        "chatgpt-gpt",
        "claude-ai",
        "claude-code",
        "claude-desktop",
        "cn-agent",
        "copilot-agent",
        "coze",
        "coze-bot",
        "custom-gpt",
        "gemini",
        "gemini-cli",
        "gemini-gem",
        "hermes",
        "kimi",
        "langchain",
        "lechat-agent",
        "llamaindex",
        "manual-test",
        "meta-ai",
        "mcp-handoff",
        "open-webui",
        "openai-codex",
        "openclaw",
        "perplexity-space",
        "pi",
        "poe-bot",
        "postman",
        "prime-agent",
        "python-client",
        "skill",
        "team-demo",
        "website",
        "website-widget",
        "zhipu-agent",
        "openai-chatgpt",
        "openai-agents-sdk",
        "openai-mcp",
        "cursor",
        "cline",
        "windsurf",
        "perplexity",
        "qwen-ecosystem",
        "deepseek",
        "doubao",
        "mcp-client"
      ]
    },
    "utm_campaign": {
      "description": "Canonical TempGuru buyer-handoff campaign",
      "type": "string",
      "enum": [
        "quote-handoff"
      ]
    },
    "utm_content": {
      "description": "Canonical originating MCP or REST channel for an attributed handoff",
      "type": "string",
      "enum": [
        "mcp",
        "rest"
      ]
    },
    "skill_version": {
      "description": "Optional version of the TempGuru staffing skill used to assemble this request",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(?:-[0-9A-Za-z.-]{1,24})?(?:\\+[0-9A-Za-z.-]{1,24})?$"
    },
    "skill_id": {
      "description": "Optional canonical TempGuru skill slug that assembled this request",
      "type": "string",
      "enum": [
        "event-staffing-ordering",
        "event-staffing-compliance",
        "staffing-plan-from-event-brief",
        "urgent-event-backfill",
        "staffing-agency-partner-growth",
        "multi-city-activation-planner",
        "event-staffing-procurement",
        "tempguru-pro-operations"
      ]
    },
    "plan_id": {
      "description": "Optional plan_id returned by plan_staffing or save_staffing_plan; links the submitted quote to its saved non-PII plan",
      "type": "string",
      "maxLength": 12,
      "pattern": "^[A-HJ-NP-Z2-9]{12}$"
    }
  },
  "required": [
    "contact_name",
    "contact_email",
    "company",
    "event_name",
    "event_type",
    "city",
    "event_dates",
    "roles"
  ],
  "additionalProperties": false,
  "$id": "https://tempguru.co/schemas/event-staffing-request.schema.json",
  "title": "TempGuru Event Staffing Quote Request",
  "description": "The exact public contract accepted by the buyer-operated POST /api/v1/quote-requests endpoint. Authless MCP request_quote accepts only a saved non-PII plan reference and returns a form link."
}
